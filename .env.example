# Neon Postgres. Create a project at https://neon.tech, copy the connection
# string, and save it as .env (which is gitignored) — never commit the real one.
#
# Use the UNPOOLED string (host without "-pooler") for `prisma db push` and the
# seed; keep the pooled one here for the app itself.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
