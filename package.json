{
  "name": "pmgo-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "test": "tsx --test lib/scoring.test.ts",
    "seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "db:reset": "prisma db push --force-reset && npm run seed",
    "db:check-mongo": "node scripts/check-mongo.mjs",
    "check:overflow": "node scripts/overflow.mjs",
    "shot": "node scripts/shot.mjs",
    "assets": "node scripts/fetch-assets.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^3.0.2",
    "framer-motion": "^13.1.1",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.5",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^6.7.0",
    "puppeteer-core": "^25.9.0",
    "shadcn": "^4.19.1",
    "tailwindcss": "^4.1.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
